# === AI 辨識引擎選擇（v0.2.0 新增）===
# vertex：Google Cloud Vertex AI Gemini（預設）；openai：OpenAI API
OCR_PROVIDER=vertex

# === OpenAI 設定（OCR_PROVIDER=openai 才需要）===
# API Key 到 platform.openai.com 申請（與 ChatGPT 訂閱分開計費），不要提交進 git
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# === Google Cloud Vertex AI 設定（OCR_PROVIDER=vertex 才需要）===
# 請填入您的 GCP 專案 ID（可使用 GCP 免費試用點數）
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# 新建的 GCP 專案實測 asia-east1／us-central1 可能回 404，global 較穩
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3-flash-preview
# Gemini 3 思考等級（low／high；留空＝模型預設）。思考 token 照輸出價計費，
# 實測預設思考一張發票約 6 萬 tokens（約 US$0.19），low 約 400 tokens。Gemini 2.x 會自動忽略此設定。
VERTEX_THINKING_LEVEL=low

# === Google Drive 資料夾 ID ===
DRIVE_FOLDER_PENDING=
DRIVE_FOLDER_DONE=
DRIVE_FOLDER_REVIEW=
DRIVE_FOLDER_FAILED=

# === Google Sheets 設定 ===
SPREADSHEET_ID=

# === 本機 Google Workspace API 憑證 ===
# auth_mode 支援 "oauth"（個人 Gmail 帳號推薦）或 "service_account"
AUTH_MODE=oauth
CREDENTIALS_PATH=credentials/oauth_client.json
TOKEN_PATH=credentials/token.json

# === 執行選項 ===
TIMEZONE=Asia/Taipei
LOCK_FILE_PATH=tmp/voucher_worker.lock
TEMP_DIR=tmp/work
MAX_RETRIES=2
